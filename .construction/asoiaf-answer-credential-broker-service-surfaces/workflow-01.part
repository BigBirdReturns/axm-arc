TE( REQUEST)?
          "(clientPrivateKeyPem|credentialPrivateKeyPem|deviceAgentPrivateKeyPem|credentialCertificateThumbprint|deviceAgentCertificateThumbprint|requestBodyBase64|responseBodyBase64|powershellExecutable|payload)"[[:space:]]*:
          provider(Pin|Password|Token|Secret|Session)[[:space:]]*["=:]
          pkcs11:[^[:space:]"']+
          PATTERNS
          if grep -RIEq \
            --exclude='full-tests.log' \
            --exclude='focused-tests.log' \
            --exclude='build.log' \
            --exclude='typecheck.log' \
            -f "$artifact_patterns" \
            "$root"; then
            echo 'Linux broker-service artifact contains forbidden key, selector, secret, or raw-body content' >&2
            exit 1
          fi
          find "$root" -type f ! -name SHA256SUMS -print0 \
            | sort -z \
            | xargs -0 sha256sum \
            | sed "s#  $root/#  #" > "$root/SHA256SUMS"
          (cd "$root" && sha256sum -c SHA256SUMS)

      - name: Upload Linux broker-service qualification
        if: always()
        uses: actions/upload-artifact@v4
        with:
          name: asoiaf-answer-credential-broker-service-linux
          path: ${{ runner.temp }}/credential-broker-service-linux-qualification
          if-no-files-found: error
          retention-days: 30
          compression-level: 0

  windows-npipe:
    if: github.repository == 'BigBirdReturns/axm-arc'
    runs-on: windows-latest
    timeout-minutes: 45
    steps:
      - name: Check out exact broker-service candidate
        uses: actions/checkout@v4
        with:
          ref: ${{ github.event_name == 'pull_request' && github.event.pull_request.head.sha || github.sha }}
          fetch-depth: 1
          show-progress: false

      - name: Bind exact Windows candidate
        shell: pwsh
        run: |
          $ErrorActionPreference = 'Stop'
          $candidate = (git rev-parse HEAD).Trim()
          if (git status --porcelain) { throw 'candidate worktree is not clean' }
          "CANDIDATE_SHA=$candidate" | Out-File -FilePath $env:GITHUB_ENV -Append -Encoding utf8

      - name: Set up Node
        uses: actions/setup-node@v4
        with:
          node-version: 22
          cache: npm

      - name: Install dependencies
        run: npm ci --no-audit --no-fund

      - name: Strict TypeScript on Windows
        shell: pwsh
        run: |
          $ErrorActionPreference = 'Stop'
          npm run typecheck | Tee-Object -FilePath (Join-Path $env:RUNNER_TEMP 'windows-typecheck.log')

      - name: Exercise real Windows named-pipe framing
        shell: pwsh
        run: |
          $ErrorActionPreference = 'Stop'
          $inputPath = Join-Path $env:RUNNER_TEMP 'windows-npipe-input.json'
          $probePath = Join-Path $env:RUNNER_TEMP 'windows-npipe-probe.json'
          @{
            endpoint = 'npipe://axm-asoiaf-answer-credential-broker-service-qualification'
            challenge = 'qualification-windows-npipe-local-service'
            timeoutMilliseconds = 30000
          } | ConvertTo-Json | Set-Content -LiteralPath $inputPath -Encoding utf8
          npm run --silent asoiaf:answer-credential-broker-service -- `
            probe-endpoint --input $inputPath --out $probePath
          $probe = Get-Content -Raw -LiteralPath $probePath | ConvertFrom-Json
          if ($probe.endpointKind -ne 'npipe') { throw 'named-pipe probe did not use npipe custody' }
          if (-not $probe.localEndpointOnly) { throw 'named-pipe probe lost local-only custody' }
          if ($probe.requestBodyRetained -or $probe.responseBodyRetained) {
            throw 'named-pipe probe retained request or response bodies'
          }
          if ($probe.authority -ne 'none' -or $probe.graphEffect -ne 'none' -or $probe.canonEffect -ne 'none' -or $probe.answerEffect -ne 'none') {
            throw 'named-pipe probe acquired forbidden authority'
          }
          @{
            format = 'axm-asoiaf-answer-credential-broker-service-windows-npipe-qualification/1'
            candidateSha = $env:CANDIDATE_SHA
            endpointKind = [string]$probe.endpointKind
            addressDigest = [string]$probe.addressDigest
            challengeDigest = [string]$probe.challengeDigest
            responseDigest = [string]$probe.responseDigest
            localEndpointOnly = $true
            requestBodyRetained = $false
            responseBodyRetained = $false
            authority = 'none'
            graphEffect = 'none'
            canonEffect = 'none'
            answerEffect = 'none'
          } | ConvertTo-Json -Depth 5 | Set-Content -LiteralPath (Join-Path $env:RUNNER_TEMP 'windows-npipe-receipt.json') -Encoding utf8
          Remove-Item -LiteralPath $inputPath -Force

      - name: Upload Windows named-pipe public receipt
        uses: actions/upload-artifact@v4
        with:
          name: asoiaf-answer-credential-broker-service-windows
          path: |
            ${{ runner.temp }}/windows-npipe-receipt.json
            ${{ runner.temp }}/windows-typecheck.log
          if-no-files-found: error
          retention-days: 30
          compression-level: 0

  combine:
    if: always() && needs.linux-qualify.result == 'success' && needs.windows-npipe.result == 'success'
    needs:
      - linux-qualify
      - windows-npipe
    runs-on: ubuntu-24.04
    timeout-minutes: 20
    steps:
      - name: Download platform receipts
        uses: actions/download-artifact@v4
        with:
          path: platform-receipts

      - name: Build combined broker-service qualification artifact
        shell: bash
        run: |
          set -euo pipefail
          root='asoiaf-answer-credential-broker-service-qualification'
          mkdir -p "$root/linux" "$root/windows"
          cp -R platform-receipts/asoiaf-answer-credential-broker-service-linux/. "$root/linux/"
          cp platform-receipts/asoiaf-answer-credential-broker-service-windows/windows-npipe-receipt.json "$root/windows/"
          cp platform-receipts/asoiaf-answer-credential-broker-service-windows/windows-typecheck.log "$root/windows/"
          linux_sha="$(tr -d '\r\n' < "$root/linux/candidate-sha.txt")"
          windows_sha="$(jq -r .candidateSha "$root/windows/windows-npipe-receipt.json")"
          test "$linux_sha" = "$windows_sha"
          printf '%s\n' "$linux_sha" > "$root/candidate-sha.txt"
          printf '%s\n' \
            'linuxUnixAuthenticatedLifecycle=passed' \
            'linuxUnixSocketMode=0600' \
            'windowsNamedPipeFraming=passed' \
            'signedRequestReplay=passed' \
            'pendingRequests=0' \
            'privateKeyRetained=false' \
            'certificateRetained=false' \
            'rawProviderSelectorRetained=false' \
            'providerSecretRetained=false' \
            'rawRequestBodyRetained=false' \
            'rawResponseBodyRetained=false' \
            'authority=none' \
            'graphEffect=none' \
            'canonEffect=none' \
            'answerEffect=none' \
            > "$root/qualification-boundary.txt"
          if find "$root" -type f \
            \( -iname '*.key' -o -iname '*.crt' -o -iname '*.pem' -o -iname '*.csr' -o -iname '*.p12' -o -iname '*.pfx' \) \
            | grep -q .; then
            echo 'combined broker-service artifact contains a forbidden secret-material path' >&2
            exit 1
          fi
          artifact_patterns="$RUNNER_TEMP/broker-service-combined-artifact-patterns.txt"
          cat > "$artifact_patterns" <<'PATTERNS'
          BEGIN (RSA |EC |ENCRYPTED )?PRIVATE KEY
          BEGIN CERTIFICATE( REQUEST)?
          "(clientPrivateKeyPem|credentialPrivateKeyPem|deviceAgentPrivateKeyPem|credentialCertificateThumbprint|deviceAgentCertificateThumbprint|requestBodyBase64|responseBodyBase64|powershellExecutable|payload)"[[:space:]]*:
          provider(Pin|Password|Token|Secret|Session)[[:space:]]*["=:]
          pkcs11:[^[:space:]"']+
          PATTERNS
          if grep -RIEq \
            --exclude='full-tests.log' \
            --exclude='focused-tests.log' \
            --exclude='build.log' \
            --exclude='typecheck.log' \
            --exclude='windows-typecheck.log' \
            -f "$artifact_patterns" \
            "$root"; then
            echo 'combined broker-service artifact contains forbidden key, selector, secret, or raw-body content' >&2
            exit 1
          fi
          find "$root" -type f ! -name SHA256SUMS -print0 \
            | sort -z \
            | xargs -0 sha256sum \
            | sed "s#  $root/#  #" > "$root/SHA256SUMS"
          (cd "$root" && sha256sum -c SHA256SUMS)

      - name: Upload combined broker-service qualification
        id: upload
        uses: actions/upload-artifact@v4
        with:
          name: asoiaf-answer-credential-broker-service-qualification
          path: asoiaf-answer-credential-broker-service-qualification
          if-no-files-found: error
          retention-days: 30
          compression-level: 0

      - name: Publish exact qualification summary
        env:
          ARTIFACT_ID: ${{ steps.upload.outputs['artifact-id'] }}
          ARTIFACT_DIGEST: ${{ steps.upload.outputs['artifact-digest'] }}
        shell: bash
        run: |
          set -euo pipefail
          candidate="$(cat asoiaf-answer-credential-broker-service-qualification/candidate-sha.txt)"
          {
            echo '## ASOIAF authenticated local credential broker service qualification'
            echo
            echo "- Candidate: \`$candidate\`"
            echo "- Artifact: \`${ARTIFACT_ID}\`"
            echo "- Artifact digest: \`${ARTIFACT_DIGEST}\`"
            echo '- Linux authenticated Unix lifecycle and exact replay: passed'
            echo '- Unix socket mode: 0600'
            echo '- Windows named-pipe framing: passed'
            echo '- Private key, selector, provider secret, raw request, and raw response retention: false'
          } >> "$GITHUB_STEP_SUMMARY"
