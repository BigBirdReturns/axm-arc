{
  "name": "axm-arc",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test",
    "sim:karazhan": "vite-node src/sim/karazhan-sim-cli.ts --",
    "build:godscar-reference": "vite-node tools/build-godscar-reference.ts",
    "build:dark-tomb-reference": "vite-node tools/build-dark-tomb-reference.ts",
    "build:common-ship-reference": "vite-node tools/build-common-ship-reference.ts",
    "build:relief-connected-fixture": "vite-node tools/build-relief-connected-fixture.ts",
    "build:clean-room-reference": "vite-node tools/build-clean-room-reference.ts",
    "creator:cli": "vite-node tools/creator-kit-cli.ts --",
    "build:creator-kit": "vite build --config vite.creator-kit.config.ts",
    "build:creator-recovery-kit": "npm run build:creator-kit && vite-node tools/build-creator-recovery-kit.ts",
    "test:action-profile-forge": "node --test tools/action-profile-forge/profile-forge.test.mjs",
    "build:action-profile-forge": "node tools/action-profile-forge/build.mjs",
    "test:continuous-authority": "vitest run tests/narrative/action-receipt-seam.test.ts tests/narrative/rails.test.ts tests/action/action-estate.test.ts",
    "test:action-player-floor": "vitest run tests/action/action-player-floor.test.ts tests/action/semantic-objectives.test.ts tests/demos/underdrain-draft.test.ts",
    "build:action-player-reference": "vite-node tools/build-action-player-floor-reference.ts"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.5"
  }
}
