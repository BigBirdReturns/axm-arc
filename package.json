{
  "name": "axm-arc",
  "description": "AXM Arc narrative systems and typed answer-desk tooling",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test",
    "sim:karazhan": "vite-node src/sim/karazhan-sim-cli.ts --",
    "build:godscar-reference": "vite-node tools/build-godscar-reference.ts",
    "build:dark-tomb-reference": "vite-node tools/build-dark-tomb-reference.ts",
    "build:common-ship-reference": "vite-node tools/build-common-ship-reference.ts",
    "build:relief-connected-fixture": "vite-node tools/build-relief-connected-fixture.ts",
    "build:clean-room-reference": "vite-node tools/build-clean-room-reference.ts",
    "creator:cli": "vite-node tools/creator-kit-cli.ts --",
    "build:creator-kit": "vite build --config vite.creator-kit.config.ts",
    "build:creator-recovery-kit": "npm run build:creator-kit && vite-node tools/build-creator-recovery-kit.ts",
    "asoiaf:external:collector": "vite-node tools/asoiaf-external-collector.ts --",
    "asoiaf:structured-acquisition:health": "vite-node tools/asoiaf-structured-acquisition-source-health.ts --",
    "asoiaf:structured-admission:health": "vite-node tools/asoiaf-structured-observation-admission-health.ts --",
    "asoiaf:research-dossier": "vite-node tools/asoiaf-research-question-dossier.ts --",
    "asoiaf:reviewed-answer": "vite-node tools/asoiaf-reviewed-answer-packet.ts --",
    "asoiaf:answer-work-order": "vite-node tools/asoiaf-answer-work-order.ts --",
    "asoiaf:answer-work-lease": "vite-node tools/asoiaf-answer-work-lease.ts --",
    "asoiaf:answer-desk": "vite-node tools/asoiaf-answer-desk-estate.ts --",
    "asoiaf:answer-worker": "vite-node tools/asoiaf-answer-desk-worker.ts --",
    "asoiaf:answer-exchange": "vite-node tools/asoiaf-answer-desk-exchange.ts --",
    "asoiaf:answer-supervisor": "vite-node tools/asoiaf-answer-desk-supervisor.ts --",
    "asoiaf:answer-transport": "vite-node tools/asoiaf-answer-desk-transport.ts --",
    "asoiaf:answer-transport-operations": "vite-node tools/asoiaf-answer-desk-transport-operations.ts --"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.5"
  }
}
